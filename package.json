{
  "name": "dishcovery-platform",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace @dishcovery/web",
    "dev:api": "npm run dev --workspace @dishcovery/api",
    "dev:worker": "npm run dev --workspace @dishcovery/worker",
    "dev": "concurrently \"npm run dev:web\" \"npm run dev:api\" \"npm run dev:worker\"",
    "build": "npm run build --workspace @dishcovery/web",
    "build:all": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspace @dishcovery/web",
    "typecheck:all": "npm run typecheck --workspaces --if-present",
    "lint": "npm run typecheck",
    "test": "npm run test --workspace @dishcovery/web",
    "test:all": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "typescript": "^5.9.3"
  }
}
